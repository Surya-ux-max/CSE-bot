# ==========================================================
# CSE-Bot Unified Repository .gitignore
# ==========================================================

# ─── Environment & Secrets (CRITICAL) ────────────────────
.env
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
server/.env

# ─── Python & Server Dependencies ────────────────────────
.venv/
venv/
env/
ENV/
server/.venv/
__pycache__/
server/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ─── Legacy Vector DB & Index Caches ──────────────────────
chroma_db/
server/chroma_db/
indexing_cache.json
server/indexing_cache.json

# ─── Node.js & React Client ──────────────────────────────
node_modules/
client/node_modules/
client/dist/
client/dist-ssr/
.pnpm-debug.log*

# ─── Logs & Debugging ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── IDE & System Files ───────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
